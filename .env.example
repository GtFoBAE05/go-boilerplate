# Every setting the app reads, written exactly as a deployment sets it.
#
#   cp .env.example .env      # local development; .env is git-ignored
#
# The values here are the LOCAL DEVELOPMENT set. The built-in defaults
# (internal/config/setDefaults) are the production-safe set, so a container that
# ships no file and sets only what it needs is already sane: production env,
# JSON logs at info, Redis required (the rate limiter must be shared), no
# boot-time migrations, pprof off.
#
# Precedence: real environment variable > .env > built-in default.
# Every value is validated at boot; a bad one fails fast and reports every
# problem at once rather than degrading silently.
#
# Names are unprefixed, so they share a namespace with everything else in the
# environment. SERVICE_* is named defensively because bare NAME and ENV are too
# generic; OTEL_* does the opposite on purpose and adopts the OpenTelemetry
# SDK's own names, so the SDK and this app cannot disagree about them.
# When adding a key, check the name against what an orchestrator might inject —
# Kubernetes sets <SERVICE>_PORT and <SERVICE>_SERVICE_HOST for every Service in
# the namespace, so avoid names like POSTGRES_PORT or REDIS_PORT.

# --- service ---------------------------------------------------------------
# SERVICE_ENV: development | staging | production
SERVICE_NAME=go-boilerplate
SERVICE_ENV=development

# --- server ----------------------------------------------------------------
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
# Slowloris guard: how long a client may take to send headers. Must not exceed
# READ_TIMEOUT, or it can never fire.
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=20s
# Per-request context deadline. Validated to stay below WRITE_TIMEOUT so the
# resulting 504 can still be written to the client.
SERVER_REQUEST_TIMEOUT=20s
# How long /readyz reports 503 before draining starts, giving an orchestrator
# time to pull this instance out of rotation. 0 disables the wait.
SERVER_DRAIN_DELAY=5s
# Comma-separated proxy CIDRs whose X-Forwarded-For header is trusted. Empty
# means never trust forwarded headers; rate limiting then keys off the TCP peer.
SERVER_TRUSTED_PROXY_CIDRS=

# --- pprof -----------------------------------------------------------------
# Profiling listener, off by default. Flip ENABLED to true when you need it;
# nothing is created while it is off (no socket, no goroutine).
#
# Keeping it off is about attack surface, not performance: pprof samples nothing
# until an endpoint is requested. It exposes raw memory and lets a caller trigger
# expensive profiles, so the bind is hardcoded to 127.0.0.1 — reach it with a
# port-forward, never by widening it. This is the only debug listener the app
# opens; metrics are pushed to a collector, not scraped from a port.
PPROF_ENABLED=false
PPROF_PORT=6060

# --- postgres --------------------------------------------------------------
# No built-in default: a deployment must supply a DSN. Production also rejects
# a DSN that does not verify the server certificate.
POSTGRES_DSN=postgres://app:app@localhost:5433/app?sslmode=disable
# Used only by cmd/migrate. Production should point it at a role with DDL
# rights, keeping POSTGRES_DSN's runtime role DML-only.
POSTGRES_MIGRATION_DSN=
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
# Spread connection reconnects across replicas instead of synchronizing them.
POSTGRES_MAX_CONN_LIFETIME_JITTER=5m
# Enforced by Postgres, so a canceled client cannot leave a query or lock wait
# running. All three are required and must be at least 1ms.
POSTGRES_STATEMENT_TIMEOUT=10s
POSTGRES_LOCK_TIMEOUT=5s
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=30s
# Apply embedded goose migrations at boot. Convenient locally; defaults to
# false. In production this must stay false: every replica migrating at once is
# a race, so CI or a dedicated job owns migrations there.
POSTGRES_MIGRATE=true
# cache_statement talks to Postgres directly. Behind a transaction-mode pooler
# (pgbouncer, RDS Proxy) prepared statements break — use exec or simple_protocol.
POSTGRES_QUERY_EXEC_MODE=cache_statement

# --- redis -----------------------------------------------------------------
# disabled = no redis and no redis-backed features
# optional = degrade gracefully: warn and run without them when unreachable
# required = fail-fast at startup when unreachable; production rate limiting
# requires this unless RATELIMIT_ALLOW_PROCESS_LOCAL=true is set deliberately
REDIS_MODE=optional
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
# Managed Redis normally requires TLS. Verification is on unless the explicit
# development escape hatch below is set; production rejects skipping it.
REDIS_TLS_ENABLED=false
REDIS_TLS_INSECURE_SKIP_VERIFY=false
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10

# --- opentelemetry ---------------------------------------------------------
# Traces AND metrics are PUSHED over OTLP/gRPC to a collector. This app serves
# no /metrics endpoint — nothing is readable without a reachable collector.
#
# These are the OpenTelemetry SDK's own variable names, used with the SDK's own
# meaning, so an operator who sets OTEL_EXPORTER_OTLP_ENDPOINT from memory gets
# what they expect. Two consequences worth knowing:
#   - OTEL_SERVICE_NAME is NOT read. SERVICE_NAME above owns the service
#     identity, because the logger uses it too.
#   - Variables not listed here still reach the exporter when set as REAL
#     environment variables (OTEL_EXPORTER_OTLP_HEADERS, _TIMEOUT,
#     _COMPRESSION): the SDK reads those itself. They do not work from .env,
#     which is parsed into the config loader, not exported to the process.
#
# Turn everything off with OTEL_SDK_DISABLED=true, or one signal with
# OTEL_TRACES_EXPORTER=none / OTEL_METRICS_EXPORTER=none.
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
# The scheme is required and selects transport security: http:// is plaintext,
# https:// is TLS. A bare host:port is rejected at boot. There is no default:
# when the SDK is enabled, a deployment must set this explicitly.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Per-signal overrides; empty means "inherit the endpoint above".
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# always_on | always_off | traceidratio | parentbased_always_on |
# parentbased_always_off | parentbased_traceidratio
# _ARG is the ratio for the traceidratio strategies; 1.0 keeps every trace,
# which is a development setting.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# MILLISECONDS, per the OTel spec — not a Go duration like the timeouts above.
# 15000 is 15s, tightened from the 60000 default so local dashboards move.
# This is also the floor on dashboard staleness: nothing is visible until an
# interval elapses.
OTEL_METRIC_EXPORT_INTERVAL=15000

# --- log -------------------------------------------------------------------
# level: debug | info | warn | error      format: text | json
LOG_LEVEL=debug
LOG_FORMAT=text

# --- ratelimit -------------------------------------------------------------
RATELIMIT_ENABLED=true
# Requests allowed per IP per window. With Redis configured the counter is
# shared, so the cap is global across replicas and a Redis failure fails closed
# with 503 RATE_LIMIT_UNAVAILABLE. REDIS_MODE=disabled uses a process-local
# counter and is intended for development only.
# Production requires REDIS_MODE=required unless RATELIMIT_ALLOW_PROCESS_LOCAL
# explicitly accepts per-replica budgets. With REDIS_MODE=optional and Redis
# down at boot, each replica would enforce its own budget. Set true only for a
# single-replica deployment (or one behind an external limiter).
RATELIMIT_ALLOW_PROCESS_LOCAL=false
RATELIMIT_REQUESTS=40
RATELIMIT_WINDOW=1s
